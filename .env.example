# ---------------------------------------------------------------------------
# Codes by Erax — variaveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# Nenhuma variavel sem o prefixo NEXT_PUBLIC_ chega ao navegador.
# ---------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# URL canonica publica. Usada em metadata, sitemap, robots e Open Graph.
NEXT_PUBLIC_SITE_URL=https://codesbyerax.com.br

# Verificacao de dominio do Zoho Mail (meta tag no <head>).
# Ja existe um valor padrao no codigo; defina aqui para sobrescrever.
NEXT_PUBLIC_ZOHO_VERIFICATION=zb68600730.zmverify.zoho.com

# --- E-mail opcional (Resend) — apenas hospedagens com servidor ---------------
# No GitHub Pages, orçamento e feedback usam Web3Forms diretamente no navegador.
# Estas variáveis permanecem apenas para os endpoints opcionais com runtime Node.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Vinculo Tutoria: distribuicao (publico) ---------------------------------
# Enquanto NEXT_PUBLIC_VINCULO_DOWNLOAD_URL estiver vazio, os botoes de download
# ficam desabilitados exibindo "Disponivel em breve" — nenhum link falso.
NEXT_PUBLIC_VINCULO_DOWNLOAD_URL=
NEXT_PUBLIC_VINCULO_STORE_URL=https://apps.microsoft.com/detail/9PMP1T5VWDGB?hl=pt-br&gl=BR&ocid=pdpshare
NEXT_PUBLIC_VINCULO_VERSION=1.4.0
NEXT_PUBLIC_VINCULO_FILE_SIZE=24 MB
NEXT_PUBLIC_VINCULO_SHA256=

# --- Contato publico ---------------------------------------------------------
# Exibido nas paginas de suporte/contato. Deixe vazio para ocultar o bloco.
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@codesbyerax.com.br
